        "    def automated_pipeline(self, audio_path, language=\"en\"):\n",
        "        \"\"\"Orchestrates the flow: Input -> Brain (Static + Pragmatic) -> UX\"\"\"\n",
        "        if not audio_path: return pd.DataFrame(), \"Waiting for audio...\"\n",
        "\n",
        "        self.last_audio_path = audio_path\n",
