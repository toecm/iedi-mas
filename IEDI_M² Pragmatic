        "\n",
        "        # Track context for pragmatics\n",
        "        conversation_history = []\n",
        "\n",
        "        for seg in segments:\n",
        "            raw_text = seg[\"text\"]\n",
        "\n",
        "            # Agent 2 Step A: Static Lookup (Dictionary)\n",
        "            dialect, clarification, matched_utterance = self.brain.detect_dialect(raw_text)\n",
        "            display_utterance = matched_utterance if matched_utterance else raw_text\n",
        "\n",
        "            # Agent 2 Step B: Pragmatic Analysis (LLM)\n",
        "            # We trigger this if a dialect is found OR if the text is long enough to have tone\n",
        "            pragmatics = \"---\"\n",
        "            if dialect != \"Unknown\" or len(raw_text.split()) > 3:\n",
        "                 pragmatics = self.brain.analyze_pragmatics(display_utterance, dialect, conversation_history)\n",
        "\n",
        "            results.append({\n",
        "                \"Speaker\": seg[\"speaker\"],\n",
        "                \"Utterance\": display_utterance,\n",
        "                \"Dialect\": dialect if dialect else \"Unknown\",\n",
        "                \"Clarification\": clarification if clarification else \"---\",\n",
        "                \"Pragmatic Context\": pragmatics # <--- NEW COLUMN\n",
        "            })\n",
