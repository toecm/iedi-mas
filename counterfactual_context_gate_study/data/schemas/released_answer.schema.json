{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cdcv/released_answer.schema.json",
  "title": "Gold-free broker projection released after a matching question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "question_id",
    "answer_id",
    "context_slot",
    "context_patch",
    "question_manifest_hash",
    "answer_manifest_hash",
    "validation_status",
    "safety_status",
    "post_answer_branch_manifest_hash",
    "post_answer_branches"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "answer_id": {"type": "string", "minLength": 1},
    "context_slot": {"$ref": "#/$defs/slot"},
    "context_patch": {"$ref": "#/$defs/contextPatch"},
    "question_manifest_hash": {"$ref": "#/$defs/sha256"},
    "answer_manifest_hash": {"$ref": "#/$defs/sha256"},
    "validation_status": {"$ref": "#/$defs/status"},
    "safety_status": {"$ref": "#/$defs/status"},
    "post_answer_branch_manifest_hash": {"$ref": "#/$defs/sha256"},
    "post_answer_branches": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/branch"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["DEMO_ONLY", "ACCEPTED"]},
    "slot": {
      "enum": [
        "relationship_role",
        "setting",
        "formality",
        "discourse_goal",
        "preceding_speech_act",
        "situation"
      ]
    },
    "contextField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "retain_after_episode"],
      "properties": {
        "value": {},
        "provenance": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "retain_after_episode": {"const": false}
      }
    },
    "contextPatch": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "additionalProperties": false,
      "properties": {
        "relationship_role": {"$ref": "#/$defs/contextField"},
        "setting": {"$ref": "#/$defs/contextField"},
        "formality": {"$ref": "#/$defs/contextField"},
        "discourse_goal": {"$ref": "#/$defs/contextField"},
        "preceding_speech_act": {"$ref": "#/$defs/contextField"},
        "situation": {"$ref": "#/$defs/contextField"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "probe_type",
        "source_candidate_id",
        "changed_slots",
        "context_patch",
        "source_context_hash",
        "result_context_hash",
        "target_candidate_id",
        "scenario_answer_id",
        "validity_weight",
        "review_status",
        "safety_status",
        "protected_attribute_manipulated",
        "gloss_leakage_detected"
      ],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "probe_type": {"enum": ["PRESERVING", "MEANING_CHANGING"]},
        "source_candidate_id": {"type": "string", "minLength": 1},
        "changed_slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slot"}
        },
        "context_patch": {"$ref": "#/$defs/contextPatch"},
        "source_context_hash": {"$ref": "#/$defs/sha256"},
        "result_context_hash": {"$ref": "#/$defs/sha256"},
        "target_candidate_id": {"type": ["string", "null"]},
        "scenario_answer_id": {"type": ["string", "null"]},
        "validity_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"$ref": "#/$defs/status"},
        "safety_status": {"$ref": "#/$defs/status"},
        "protected_attribute_manipulated": {"const": false},
        "gloss_leakage_detected": {"const": false}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate_id", "preserving", "meaning_changing"],
      "properties": {
        "source_candidate_id": {"type": "string", "minLength": 1},
        "preserving": {"$ref": "#/$defs/probe"},
        "meaning_changing": {"$ref": "#/$defs/probe"}
      }
    }
  }
}
