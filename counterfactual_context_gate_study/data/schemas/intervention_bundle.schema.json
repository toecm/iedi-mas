{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cdcv/intervention_bundle.schema.json",
  "title": "Symmetric candidate-indexed runtime intervention bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "family_id",
    "base_case_id",
    "utterance_hash",
    "candidate_set_hash",
    "variety_cue_fixed",
    "candidate_branches",
    "symmetric_for_all_core_candidates",
    "constructed_without_sealed_reference_action",
    "integrity_manifest_hash",
    "validation"
  ],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "base_case_id": {"type": "string", "minLength": 1},
    "utterance_hash": {"$ref": "#/$defs/sha256"},
    "candidate_set_hash": {"$ref": "#/$defs/sha256"},
    "variety_cue_fixed": {"const": true},
    "symmetric_for_all_core_candidates": {"const": true},
    "constructed_without_sealed_reference_action": {"const": true},
    "candidate_branches": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidateBranch"}
    },
    "integrity_manifest_hash": {"$ref": "#/$defs/sha256"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slot": {
      "enum": [
        "relationship_role",
        "setting",
        "formality",
        "discourse_goal",
        "preceding_speech_act",
        "situation"
      ]
    },
    "candidateBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate_id", "preserving", "meaning_changing"],
      "properties": {
        "source_candidate_id": {"type": "string", "not": {"const": "OTHER_UNLISTED"}},
        "preserving": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/preservingIntervention"}
        },
        "meaning_changing": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/changingIntervention"}
        }
      }
    },
    "preservingIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "changed_slots", "context_patch_ref", "source_context_hash", "result_context_hash", "expected_relation", "target_agreement_count", "naturalness_median", "coherence_median", "safety_approved", "gloss_leakage_detected"],
      "properties": {
        "intervention_id": {"type": "string"},
        "changed_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slot"}},
        "context_patch_ref": {"type": "string"},
        "source_context_hash": {"$ref": "#/$defs/sha256"},
        "result_context_hash": {"$ref": "#/$defs/sha256"},
        "expected_relation": {"const": "SAME_AS_BRANCH_SOURCE"},
        "target_agreement_count": {"type": "integer", "minimum": 4, "maximum": 5},
        "naturalness_median": {"type": "number", "minimum": 4, "maximum": 5},
        "coherence_median": {"type": "number", "minimum": 4, "maximum": 5},
        "safety_approved": {"const": true},
        "gloss_leakage_detected": {"const": false}
      }
    },
    "changingIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "changed_slots", "context_patch_ref", "source_context_hash", "result_context_hash", "target_candidate_id", "expected_relation", "target_agreement_count", "naturalness_median", "coherence_median", "minimality_median", "safety_approved", "gloss_leakage_detected"],
      "properties": {
        "intervention_id": {"type": "string"},
        "changed_slots": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/slot"}},
        "context_patch_ref": {"type": "string"},
        "source_context_hash": {"$ref": "#/$defs/sha256"},
        "result_context_hash": {"$ref": "#/$defs/sha256"},
        "target_candidate_id": {"type": "string", "not": {"const": "OTHER_UNLISTED"}},
        "expected_relation": {"const": "TARGET_BRANCH_CANDIDATE"},
        "target_agreement_count": {"type": "integer", "minimum": 4, "maximum": 5},
        "naturalness_median": {"type": "number", "minimum": 4, "maximum": 5},
        "coherence_median": {"type": "number", "minimum": 4, "maximum": 5},
        "minimality_median": {"type": "number", "minimum": 4, "maximum": 5},
        "safety_approved": {"const": true},
        "gloss_leakage_detected": {"const": false}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "validator_count", "minimum_agreement", "creator_excluded", "open_response_first", "ethics_release_code"],
      "properties": {
        "status": {"enum": ["candidate", "accepted", "rejected"]},
        "validator_count": {"const": 5},
        "minimum_agreement": {"const": 4},
        "creator_excluded": {"const": true},
        "open_response_first": {"const": true},
        "ethics_release_code": {"type": "string", "minLength": 1}
      }
    }
  }
}
