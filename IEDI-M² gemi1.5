        "import json\n",
        "\n",
        "# Define the Lab Persona\n",
        "nsl_lab_data = {\n",
        "  \"lab_name\": \"NSL Lab (Network & Systems Lab)\",\n",
        "  \"cultural_context\": \"Mixed Korean and International environment. High hierarchical distance.\",\n",
        "  \"jargon\": {\n",
        "    \"LEO\": \"Low Earth Orbit satellite simulation setup.\",\n",
        "    \"Doppler\": \"Doppler shift compensation algorithm in OFDM systems.\",\n",
        "    \"The rig\": \"The multi-sensor UAV simulation testbed.\",\n",
        "    \"Prof\": \"The Principal Investigator (PI). His requests are absolute priority.\",\n",
        "    \"Paper deadline\": \"Code for 'Cancel all personal plans, we sleep in the lab'.\",\n",
        "    \"Blue screen\": \"Specific error on the flight controller (not Windows).\",\n",
        "    \"Calibration\": \"UAV sensor fusion alignment process.\"\n",
        "  },\n",
        "  \"pragmatic_rules\": [\n",
        "    {\n",
        "      \"trigger\": \"Can you check...\",\n",
        "      \"speaker_role\": \"Senior/Prof\",\n",
        "      \"interpretation\": \"This is a soft command. Do it immediately.\",\n",
        "      \"tone\": \"Polite but Authoritative\"\n",
        "    },\n",
        "    {\n",
        "      \"trigger\": \"It's a bit difficult\",\n",
        "      \"speaker_role\": \"Junior/Korean Member\",\n",
        "      \"interpretation\": \"Refusal. They cannot do it but cannot say 'No' directly to a superior.\",\n",
        "      \"tone\": \"Evasive / Apologetic\"\n",
        "    },\n",
        "    {\n",
        "      \"trigger\": \"Coffee?\",\n",
        "      \"speaker_role\": \"Any\",\n",
        "      \"interpretation\": \"Request for informal sync/brainstorming away from the lab bench.\",\n",
        "      \"tone\": \"Casual / Bonding\"\n",
        "    },\n",
        "    {\n",
        "      \"trigger\": \"Service\",\n",
        "      \"speaker_role\": \"Restaurant Staff/Host\",\n",
        "      \"interpretation\": \"This item is free/on the house.\",\n",
        "      \"tone\": \"Hospitality\"\n",
        "    }\n",
        "  ]\n",
        "}\n",
